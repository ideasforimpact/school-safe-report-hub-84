# Supabase (required for worker to fetch data and upload PDF)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Inngest (required for serve handler; get from Inngest Cloud dashboard)
INNGEST_SIGNING_KEY=your-inngest-signing-key

# Optional: dev only (so Dev Server in Docker can reach this worker)
# Linux: 172.17.0.1  |  Mac/Windows: host.docker.internal
INNGEST_SERVE_HOST=http://172.17.0.1:3000
INNGEST_DEV=1
